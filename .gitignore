# Credenciales
.env
# Datos crudos: comparendos con cédula, nombre y placa (datos personales)
data/raw/*
!data/raw/.gitkeep
# Procesados intermedios pesados
data/processed/*.parquet
data/processed/cache/
# Entorno
.venv/
venv/
__pycache__/
*.pyc
.ipynb_checkpoints/
# Derivados regenerables
data/processed/*.gpkg
# Lleva números de comparendo: no se versiona
outputs/tables/comparendos_apartados.csv
# Paquetes para enviar por correo (copias de entregables versionados)
outputs/envio/
# Registros puntuales de revisión (fecha, dirección, coordenada): no se publican (decisión 26)
outputs/tables/revision_geocodificacion_en_zona.csv
outputs/tables/revision_geocodificacion_muestra_fuera.csv
outputs/tables/siniestros_en_zona_revision.csv
outputs/tables/siniestros_contraste_victimas.csv
# Registros locales de las rondas de decisión de diseño (impeccable)
.impeccable/questions/
.impeccable/review/
